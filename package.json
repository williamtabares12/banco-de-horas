{
  "name": "banco-de-horas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "check:estilo": "node scripts/check-estilo.mjs --estricto",
    "test": "vitest run",
    "emuladores": "firebase emulators:start --only auth,firestore",
    "test:nube": "firebase emulators:exec --only firestore \"vitest run tests/reglas.test.ts tests/reglasParametros.test.ts tests/parametrosNube.test.ts tests/repositorioFirestore.test.ts tests/importar.test.ts\"",
    "dev:nube": "vite --mode nube",
    "dev:emulador": "vite --mode emulador",
    "build:nube": "tsc -b && vite build --mode nube --outDir dist-nube"
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-tools": "^15.34.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.4"
  }
}
