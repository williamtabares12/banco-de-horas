rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada persona maneja solo lo que cuelga de su propio uid (perfil, config, turnos, movimientos).
    // Cualquier otra ruta queda denegada por defecto. Las validaciones de tipo vienen después (plan-nube.md §3).
    match /usuarios/{uid}/{documento=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Parámetros globales (plan-nube.md §6b): los lee cualquier persona con sesión y nadie los escribe
    // desde la app. Alejandro los edita desde la consola de Firebase, que no pasa por estas reglas.
    match /configuracion/parametros {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
